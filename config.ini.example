[aws]
# AWSアカウントID (12桁の数字を入力してください)
aws_account_id = YOUR_AWS_ACCOUNT_ID

# デプロイ対象のリージョン
aws_region = ap-northeast-1

[environment]
# 環境名 (dev, test, prod など)
env_name = prod

# アラート通知用メールアドレス (通知を受け取るアドレスを入力してください)
notification_email = your-email@example.com

[s3]
# イミュータブルバックアップ用S3バケット名 (世界でユニークな名前にする必要があります)
backup_s3_bucket_name = your-unique-immutable-backup-bucket-name

[github]
# OIDC連携を行うGitHubリポジトリ名 (所有者/リポジトリ名)
github_repository = YOUR_GITHUB_OWNER/YOUR_GITHUB_REPO
